AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
APP_DEBUG_ERRORS=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# Supabase. The publishable (anon) key is public by design and safe in browser
# JS: what it can reach is decided by Row Level Security on the project. A
# service role key must never be put in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, and the two most dangerous values in this file.
#
# The service role bypasses Row Level Security entirely — it is the only key
# that can reach `google_credentials`, which is why it must never appear in a
# NEXT_PUBLIC_ variable or in anything the browser bundle imports.
#
# GOOGLE_TOKEN_ENCRYPTION_KEY is 32 random bytes, base64. It encrypts every
# stored Google refresh token, and it is deliberately not held by the database:
# a copy of the table is useless without it. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating it invalidates every stored connection — everyone signs in again.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Which sign-in path /login offers: `authjs` (default) or `supabase`.
# Only set this to `supabase` after docs/runbooks/supabase-auth-setup.md is
# done — the API accepts both sessions regardless, so switching signs nobody out.
AUTH_PROVIDER=
