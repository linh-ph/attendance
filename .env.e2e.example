# Browser-proof environment (non-production only).
#
# Copy to `.env.e2e` if you want to override the defaults `playwright.config.ts`
# already passes to its web server. `.env.e2e` is gitignored; this example file
# carries variable names and obviously fake local values only.
#
# E2E_TEST_MODE is refused outright when NODE_ENV is `production`: the runtime
# guard throws instead of enabling the deterministic adapter. Never set it in a
# deployed environment.

# Opt in to the deterministic Drive/Sheets adapter. The only accepted value.
E2E_TEST_MODE=1

# Shared secret the `POST /api/e2e/reset` control endpoint requires in the
# `X-E2E-Secret` header. Local-only; it protects nothing real.
E2E_TEST_SECRET=local-playwright-only

# Auth.js session encryption key for the local browser-proof server only.
AUTH_SECRET=local-playwright-only-auth-secret
AUTH_URL=http://127.0.0.1:3100
AUTH_TRUST_HOST=true

# The Google provider is never contacted in test mode, but Auth.js still wants
# a configured client. These are placeholders, not credentials.
AUTH_GOOGLE_ID=e2e-google-client-id
AUTH_GOOGLE_SECRET=e2e-google-client-secret

# Google Picker is mocked at its external callback, so these only have to be
# non-empty for the app's own configuration check.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=e2e-picker-api-key
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
